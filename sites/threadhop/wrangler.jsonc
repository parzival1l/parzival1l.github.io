{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers with static assets only — no Worker script yet.
  // Add "main" + @astrojs/cloudflare when /api or live demos need a server.
  "name": "threadhop-site",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "threadhop.parzival.computer", "custom_domain": true }
  ]
}
