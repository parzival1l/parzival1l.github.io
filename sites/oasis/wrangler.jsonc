{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers with static assets only, like threadhop-site.
  "name": "oasis-site",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "oasis.parzival.computer", "custom_domain": true }
  ]
}
